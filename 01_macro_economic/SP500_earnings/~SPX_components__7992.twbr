      <aliases enabled='yes' />
      <column caption='Revenue YoY' datatype='real' name='[Calculation_429249382330290176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([revenue]) - LOOKUP(SUM([revenue]), -4)) / (LOOKUP(SUM([revenue]), -4))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Net Income Margin' datatype='real' name='[Calculation_429249382331801601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([net_income]) / sum([revenue])' />
      </column>
      <column caption='EPS_derived' datatype='real' name='[Calculation_842173179643404288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([net_income])/sum([share])' />
      </column>
      <column caption='Share_yoy' datatype='real' name='[Calculation_842173179647254532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([share])/lookup(sum([share]),-4)-1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[Constituents (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Constituents]' default='&quot;Other&quot;' new-bin='true'>
          <bin default-name='true' value='&quot;NYSE:CLF&quot;'>
            <value>&quot;NYSE:CLF&quot;</value>
          </bin>
          <bin default-name='true' value='&quot;NYSE:NUE&quot;'>
            <value>&quot;NYSE:NUE&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Constituents]' role='dimension' type='nominal' />
      <column caption='EPS_yoy' datatype='real' name='[EPS_derived (copy)_842173179644121090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([net_income])/sum([share]) / lookup(sum([net_income])/sum([share]), -4) - 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='IO Share' datatype='real' name='[IO_Share]' role='measure' type='quantitative' />
      <column datatype='string' name='[Industry Group (group) 3]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Industry Group]' default='&quot;Other&quot;' new-bin='true'>
