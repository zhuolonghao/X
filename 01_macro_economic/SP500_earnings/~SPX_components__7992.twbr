      </column>
      <column datatype='string' name='[Industry Group]' role='dimension' type='nominal' />
      <column caption='Net Income Margin_yoy' datatype='real' name='[Net Income Margin (copy)_842173179646922755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([net_income]) / sum([revenue]) - lookup(sum([net_income]) / sum([revenue]),-4)'>
          <table-calc ordering-type='Rows' />
        </calculation>
